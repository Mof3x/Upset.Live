# Public Directus API origin used by the browser.
# Do not put admin tokens, database credentials, or service keys in VITE_ variables.
VITE_DIRECTUS_URL=https://cms.example.com

# Optional. A server-side endpoint (e.g. a Cloudflare Worker) that validates,
# rate-limits and stores form submissions with its own credential. Forms POST
# JSON to <endpoint>/<kind> (contact, commission, newsletter, vault-request).
# When unset, forms open a pre-filled email to VITE_CONTACT_EMAIL instead.
# VITE_FORMS_ENDPOINT=https://forms.example.com

# Optional. Address used for the email fallback. Defaults to hello@upset.live.
# VITE_CONTACT_EMAIL=hello@upset.live

# Optional. The checkout Worker (workers/checkout) that starts Stripe payments.
# When unset, no Buy buttons are shown and items stay "Request information" only.
# Local testing with `npx wrangler dev`: http://localhost:8787
# VITE_CHECKOUT_ENDPOINT=https://upset-checkout.<your-subdomain>.workers.dev
