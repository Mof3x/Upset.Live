# Copy to .dev.vars for `npx wrangler dev`. .dev.vars is git-ignored: never commit real keys.
# Use Stripe TEST keys locally (sk_test_...). The webhook secret comes from `stripe listen`.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
DIRECTUS_TOKEN=replace_with_the_checkout_worker_user_token
